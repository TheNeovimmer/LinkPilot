// LinkPilot — Prisma schema (PostgreSQL + pgvector)
// Domain models are scoped to a single user (the owner of the account).

generator client {
  provider      = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Better Auth tables (prisma adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  issuer                String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

/// Personal profile + AI preferences for the single account owner.
model Profile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  title       String? // e.g. "Staff Software Engineer"
  location    String?
  linkedinUrl String?
  /// AI writing tone used for drafts: professional | casual | confident | concise
  tone        String   @default("professional")
  /// Career goals injected as AI context (job target, salary range, industries).
  goals       Json?
  preferences Json?
  updatedAt   DateTime @updatedAt
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

model Conversation {
  id                String             @id @default(cuid())
  userId            String
  contactName       String
  contactLinkedInUrl String?
  contactHeadline   String?
  companyId         String?
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  recruiterId       String?
  recruiter         Recruiter?         @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  status            ConversationStatus @default(ACTIVE)
  pinned            Boolean            @default(false)
  lastMessageAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  messages          Message[]

  @@index([userId, status])
  @@index([userId, lastMessageAt])
}

enum MessageRole {
  ME
  THEM
  AI
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  createdAt      DateTime    @default(now())

  @@index([conversationId, createdAt])
}

enum RecruiterStatus {
  NEW
  CONTACTED
  RESPONDED
  INTERVIEW_SCHEDULED
  OFFER
  REJECTED
  INACTIVE
}

model Recruiter {
  id             String           @id @default(cuid())
  userId         String
  name           String
  companyId      String?
  company        Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title          String?
  linkedinUrl    String?
  email          String?
  phone          String?
  notes          String?
  status         RecruiterStatus  @default(NEW)
  lastContactAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  conversations  Conversation[]
  interviews     Interview[]

  @@index([userId, status])
}

model Company {
  id            String         @id @default(cuid())
  userId        String
  name          String
  industry      String?
  website       String?
  location      String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  recruiters    Recruiter[]
  conversations Conversation[]
  jobs          Job[]

  @@index([userId])
}

enum JobStatus {
  WATCHLIST
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  CLOSED
}

model Job {
  id          String     @id @default(cuid())
  userId      String
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title       String
  url         String?
  description String?
  location    String?
  remote      Boolean    @default(false)
  salaryMin   Int?
  salaryMax   Int?
  status      JobStatus  @default(WATCHLIST)
  /// 0-100 AI fit score (populated by the analyze-job flow).
  fitScore    Int?
  /// AI analysis: summary, strengths, gaps, questions (JSON).
  analysis    Json?
  /// pgvector embedding for optional semantic job search (1536-dim).
  embedding   Unsupported("vector(1536)")?
  postedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  applications Application[]
  interviews  Interview[]

  @@index([userId, status])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  jobId       String?
  job         Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// Free-text fields so an application can exist without a tracked job.
  companyName String?
  roleTitle   String?
  status      ApplicationStatus @default(DRAFT)
  appliedAt   DateTime?
  notes       String?
  coverLetter String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  interviews  Interview[]

  @@index([userId, status])
}

enum InterviewMode {
  PHONE
  VIDEO
  ONSITE
  TECHNICAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model Interview {
  id            String          @id @default(cuid())
  userId        String
  jobId         String?
  job           Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  recruiterId   String?
  recruiter     Recruiter?      @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  title         String
  scheduledAt   DateTime
  durationMin   Int             @default(45)
  mode          InterviewMode   @default(VIDEO)
  status        InterviewStatus @default(SCHEDULED)
  location      String?
  feedback      String?
  /// AI prep: topics, likely questions, tips (JSON).
  prep          Json?
  /// Set when the 24h-before reminder notification has fired.
  remindedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, scheduledAt])
  @@index([userId, status])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String?
  pinned    Boolean  @default(false)
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, pinned])
}

model Reminder {
  id         String    @id @default(cuid())
  userId     String
  title      String
  body       String?
  dueAt      DateTime
  done       Boolean   @default(false)
  remindedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, dueAt])
  @@index([userId, done])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  /// REMINDER | INTERVIEW | AI | SYSTEM
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
